NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Local `pnpm dev:web`: API on host. Docker Compose overrides this to http://api:4000.
API_INTERNAL_URL=http://localhost:4000

# Managed Postgres + Redis (not started by Docker Compose).
# Examples: Aiven Postgres (sslmode=require), Upstash Redis (rediss://…).
# Keep connection_limit low on free Aiven — each PG connection uses server RAM.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10
REDIS_URL=rediss://default:PASSWORD@HOST:6379
# inline = no BullMQ Redis polling (required for Upstash free ~500k cmds/month).
# bullmq = Redis queues (only with a paid Redis that allows high command volume).
QUEUE_DRIVER=inline
# Tip: recover storage with: pnpm cleanup:free-tier

SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=opsbridge_session
DEMO_PASSWORD=Opsbridge-demo-2026

# Filled in later phases. Secrets stay on the API.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_AREA_CODE=SG
NEXCONN_API_BASE_URL=https://api.sg-light-api.com
NEXT_PUBLIC_NEXCONN_APP_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound email (nodemailer). Leave SMTP_HOST empty in local/dev to log messages.
MAIL_FROM=Opsbridge <noreply@opsbridge.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
